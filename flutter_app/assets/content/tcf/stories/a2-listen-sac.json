  "sentences": [
    {
      "fr": "Après son cours, Léa rentre chez elle sans son sac bleu.",
      "en": "After class, Léa goes home without her blue bag."
    },
    {
      "fr": "Elle se rappelle l'avoir posé près de la salle de réunion.",
      "en": "She remembers putting it near the meeting room."
    },
    {
      "fr": "Elle téléphone au centre communautaire avant la fermeture.",
      "en": "She calls the community centre before it closes."
    },
    {
      "fr": "À l'accueil, un employé lui demande de décrire le sac.",
      "en": "At reception, an employee asks her to describe the bag."
    },
    {
      "fr": "Léa précise qu'il est bleu, avec une petite étiquette rouge.",
      "en": "Léa explains that it is blue, with a small red tag."
    },
    {
      "fr": "L'employé retrouve le sac dans la salle.",
      "en": "The employee finds the bag in the room."
    },
    {
      "fr": "Léa revient au centre avec sa carte d'identité.",
      "en": "Léa returns to the centre with her ID card."
    },
    {
      "fr": "Elle vérifie le contenu avant de partir.",
      "en": "She checks the contents before leaving."
    },
    {
      "fr": "Elle remercie l'équipe et met son sac près de la porte.",
      "en": "She thanks the staff and puts her bag by the door."
    }
  ],
