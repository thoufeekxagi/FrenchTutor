  "sentences": [
    {
      "fr": "Sam cherchait un logement qui lui permettrait de garder son emploi et de suivre des cours du soir.",
      "en": "Sam was looking for a home that would let him keep his job and attend evening classes."
    },
    {
      "fr": "La première annonce présentait un appartement près de son travail, mais loin du centre de formation.",
      "en": "The first listing described an apartment near his work but far from the training centre."
    },
