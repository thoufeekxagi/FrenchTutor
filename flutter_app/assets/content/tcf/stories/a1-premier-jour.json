  "summary": "A newcomer takes the bus on a cold morning to start a new job.",
  "unit": "a1-u01",
  "sentences": [
    {
      "fr": "Aujourd'hui, c'est mon premier jour de travail.",
      "en": "Today is my first day of work."
    },
    {
      "fr": "Je prends l'autobus à sept heures.",
      "en": "I take the bus at seven o'clock."
    },
    {
      "fr": "Il fait froid, alors je porte un manteau.",
      "en": "It is cold, so I wear a coat.",
      "note": "Il fait froid is how French talks about the weather. It literally says it makes cold."
    },
    {
      "fr": "J'arrive au bureau à huit heures.",
      "en": "I arrive at the office at eight o'clock."
    },
    {
      "fr": "Ma gérante s'appelle Karine.",
      "en": "My manager is called Karine.",
      "note": "Many job titles have a feminine form: gérante for a woman, gérant for a man."
    },
    {
      "fr": "Elle dit : « Bonjour et bienvenue ! »",
      "en": "She says: \"Hello and welcome!\""
    },
    {
      "fr": "Je suis un peu nerveux, mais content.",
      "en": "I am a little nervous, but happy."
    },
    {
      "fr": "C'est une bonne journée !",
      "en": "It is a good day!"
    }
  ],
