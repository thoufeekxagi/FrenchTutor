  "sentences": [
    {
      "fr": "Awa part tôt pour son travail, comme chaque mardi.",
      "en": "Awa leaves early for work, as she does every Tuesday."
    },
    {
      "fr": "À l'arrêt, elle voit un avis : la ligne est interrompue près du pont.",
      "en": "At the stop, she sees a notice: the route is interrupted near the bridge."
    },
    {
      "fr": "Le détour ajoute vingt minutes au trajet.",
      "en": "The detour adds twenty minutes to the commute."
    },
    {
      "fr": "Awa demande au chauffeur quelle correspondance prendre.",
      "en": "Awa asks the driver which connection to take."
    },
    {
      "fr": "Il lui conseille de descendre au marché et de prendre le tramway.",
      "en": "He advises her to get off at the market and take the tram."
    },
    {
      "fr": "Elle envoie un message à sa responsable pour prévenir de son retard.",
      "en": "She messages her manager to warn her she will be late."
    },
    {
      "fr": "La responsable répond que l'équipe commence par une réunion en ligne.",
      "en": "The manager replies that the team is starting with an online meeting."
    },
    {
      "fr": "Awa prend le détour sans se presser.",
      "en": "Awa takes the detour without rushing."
    },
    {
      "fr": "Elle arrive avant la réunion et garde l'avis pour le trajet du soir.",
      "en": "She arrives before the meeting and keeps the notice for the evening commute."
    }
  ],
