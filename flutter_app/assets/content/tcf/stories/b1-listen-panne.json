{
  "id": "b1-listen-panne",
  "title": "La panne avant la rencontre",
  "titleEn": "The outage before the meeting",
  "level": "B1",
  "mode": "listening",
  "minutes": 5,
  "summary": "A power outage interrupts a community workshop; the organizer moves the group, preserves access, and explains the decision afterward.",
  "unit": "b1-u02",
  "sentences": [
    {
      "fr": "À quelques minutes du début d'un atelier de recherche d'emploi, l'éclairage s'est éteint dans la salle.",
      "en": "A few minutes before a job-search workshop, the lights went out in the room."
    },
    {
      "fr": "L'organisatrice a d'abord vérifié si le problème touchait tout l'immeuble.",
      "en": "The organizer first checked whether the problem affected the whole building."
    },
    {
      "fr": "Comme l'ascenseur ne fonctionnait plus, elle a écarté l'idée de déplacer les participants à l'étage.",
      "en": "Since the elevator no longer worked, she ruled out moving participants upstairs."
    },
    {
      "fr": "Elle a appelé le centre voisin, qui avait une salle libre au rez-de-chaussée.",
      "en": "She called a nearby centre, which had a room free on the ground floor."
    },
    {
      "fr": "Un collègue a envoyé l'adresse et les consignes d'accès par texto.",
      "en": "A colleague sent the address and access instructions by text."
    },
    {
      "fr": "La moitié du groupe était déjà arrivée; l'organisatrice a donc attendu quelques minutes avant de partir.",
      "en": "Half the group had already arrived, so the organizer waited a few minutes before leaving."
    },
    {
      "fr": "Tout le monde a pu suivre l'atelier, même si le début a été retardé.",
      "en": "Everyone was able to attend the workshop, even though the start was delayed."
    },
    {
      "fr": "Après la séance, elle a proposé de confirmer l'accessibilité des salles de remplacement à l'avance.",
      "en": "After the session, she proposed confirming the accessibility of backup rooms in advance."
    },
    {
      "fr": "Le groupe a accepté, car cette vérification évitera de décider dans l'urgence la prochaine fois.",
      "en": "The group agreed because this check will prevent them from deciding in a rush next time."
    }
  ],
