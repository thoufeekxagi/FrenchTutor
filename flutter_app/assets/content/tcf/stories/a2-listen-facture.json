  "title": "La facture du téléphone",
  "titleEn": "The phone bill",
  "level": "A2",
  "mode": "listening",
  "minutes": 4,
  "summary": "A confusing phone bill prompts Karim to compare the invoice with his plan and ask customer service for a correction.",
  "unit": "a2-u05",
  "sentences": [
    {
      "fr": "Karim reçoit sa facture de téléphone par courriel.",
      "en": "Karim receives his phone bill by email."
    },
    {
      "fr": "Le montant est plus élevé que le mois précédent.",
      "en": "The amount is higher than the previous month."
    },
    {
      "fr": "Il ouvre son compte et compare les détails avec son forfait.",
      "en": "He opens his account and compares the details with his plan."
    },
    {
      "fr": "Un frais apparaît deux fois, avec la même date.",
      "en": "One fee appears twice, with the same date."
    },
    {
      "fr": "Karim appelle le service à la clientèle.",
      "en": "Karim calls customer service."
    },
    {
      "fr": "La conseillère vérifie son dossier et reconnaît une erreur.",
      "en": "The adviser checks his file and recognizes an error."
    },
    {
      "fr": "Elle retire le deuxième frais et envoie une facture corrigée.",
      "en": "She removes the second fee and sends a corrected bill."
    },
    {
      "fr": "Karim demande un numéro de suivi pour sa demande.",
      "en": "Karim asks for a reference number for his request."
    },
    {
      "fr": "Il note le numéro avec la date de l'appel.",
      "en": "He writes down the number and the date of the call."
    }
  ],
