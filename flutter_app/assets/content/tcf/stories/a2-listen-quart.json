{
  "id": "a2-listen-quart",
  "title": "Un quart à échanger",
  "titleEn": "A shift to exchange",
  "level": "A2",
  "mode": "listening",
  "minutes": 4,
  "summary": "A childcare conflict threatens a work shift, so two colleagues make a clear exchange and confirm it with their supervisor.",
  "unit": "a2-u07",
  "sentences": [
    {
      "fr": "Mina reçoit un message de la garderie : elle ferme plus tôt jeudi.",
      "en": "Mina gets a message from daycare: it is closing early on Thursday."
    },
    {
      "fr": "Ce jour-là, Mina termine son quart à six heures.",
      "en": "That day, Mina's shift ends at six."
    },
    {
      "fr": "Elle demande à son collègue Hugo s'il peut échanger son horaire.",
      "en": "She asks her colleague Hugo whether he can exchange shifts."
    },
    {
      "fr": "Hugo travaille le matin, mais il est libre jeudi après-midi.",
      "en": "Hugo works in the morning, but he is free Thursday afternoon."
    },
    {
      "fr": "Ils proposent de changer les deux quarts.",
      "en": "They suggest swapping the two shifts."
    },
    {
      "fr": "Mina envoie la proposition à leur responsable.",
      "en": "Mina sends the proposal to their supervisor."
    },
    {
      "fr": "La responsable vérifie l'horaire de l'équipe et confirme l'échange.",
      "en": "The supervisor checks the team's schedule and confirms the swap."
    },
    {
      "fr": "Mina peut maintenant chercher son enfant à l'heure.",
      "en": "Mina can now pick up her child on time."
    },
    {
      "fr": "Hugo reçoit le nouveau calendrier par écrit.",
      "en": "Hugo receives the new schedule in writing."
    }
  ],
