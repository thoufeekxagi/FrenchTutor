  "title": "Le trajet réorganisé",
  "titleEn": "A commute reorganized",
  "level": "B1",
  "mode": "listening",
  "minutes": 5,
  "summary": "A temporary transit closure disrupts a caregiver's routine, and she compares realistic options with the people who depend on her timing.",
