  "sentences": [
    {
      "fr": "Des travaux ont fermé une station que Léa utilisait pour aller chercher son père après son rendez-vous.",
      "en": "Construction closed a station Léa used to pick up her father after his appointment."
    },
    {
      "fr": "La première annonce indiquait un détour, sans préciser la durée du trajet.",
      "en": "The first notice gave a detour but did not specify how long the trip would take."
    },
    {
      "fr": "Plutôt que de choisir la première solution proposée en ligne, Léa a comparé l'autobus, le train et la marche.",
      "en": "Rather than choose the first option suggested online, Léa compared the bus, train, and walking."
    },
    {
      "fr": "Le trajet à pied était trop long pour son père, tandis que l'autobus exigeait une correspondance incertaine.",
      "en": "The walk was too long for her father, while the bus required an uncertain connection."
    },
    {
      "fr": "Elle a appelé le centre de transport pour vérifier les horaires adaptés.",
      "en": "She called the transit centre to check accessible schedules."
    },
    {
      "fr": "Un agent lui a conseillé une station voisine avec un ascenseur en service.",
      "en": "An agent recommended a nearby station with a working elevator."
    },
    {
      "fr": "Léa a transmis l'itinéraire à son père et lui a demandé de confirmer le point de rencontre.",
      "en": "Léa sent the route to her father and asked him to confirm the meeting point."
    },
    {
      "fr": "Ils se sont retrouvés sans attendre dehors, malgré la pluie.",
      "en": "They met without having to wait outside, despite the rain."
    },
    {
      "fr": "Léa a gardé le numéro du centre, car les travaux devaient durer plusieurs semaines.",
      "en": "Léa kept the centre's number because the construction was expected to last several weeks."
    }
  ],
