{
  "id": "b1-listen-atelier",
  "title": "L'atelier qui déborde",
  "titleEn": "The workshop with too many registrations",
  "level": "B1",
  "mode": "listening",
  "minutes": 5,
  "summary": "A popular workshop exceeds its room capacity, and the team creates a fair second session instead of turning people away without a plan.",
  "unit": "b1-u05",
  "sentences": [
    {
      "fr": "Le centre communautaire avait annoncé un atelier gratuit sur la préparation d'un budget.",
      "en": "The community centre had announced a free workshop on preparing a budget."
    },
    {
      "fr": "Deux jours plus tard, les inscriptions dépassaient déjà la capacité de la salle.",
      "en": "Two days later, registrations already exceeded the room's capacity."
    },
    {
      "fr": "L'équipe aurait pu fermer la liste, mais plusieurs personnes attendaient encore une réponse.",
      "en": "The team could have closed the list, but several people were still waiting for an answer."
    },
    {
      "fr": "Après avoir consulté l'animatrice, elle a proposé une deuxième séance le samedi.",
      "en": "After consulting the facilitator, it proposed a second session on Saturday."
    },
    {
      "fr": "La première séance a été réservée aux personnes qui avaient besoin d'une réponse rapide.",
      "en": "The first session was reserved for people who needed a quick answer."
    },
    {
      "fr": "Les autres ont reçu le nouveau choix avec une date limite pour confirmer.",
      "en": "The others received the new option with a deadline to confirm."
    },
    {
      "fr": "Cette règle a évité de favoriser seulement les personnes qui connaissaient déjà le personnel.",
      "en": "This rule avoided favouring only people who already knew the staff."
    },
    {
      "fr": "Les deux séances ont finalement affiché complet, sans dépasser le nombre de places.",
      "en": "Both sessions eventually filled up without exceeding the number of seats."
    },
    {
      "fr": "L'équipe a décidé de demander les inscriptions plus tôt pour le prochain atelier.",
      "en": "The team decided to open registration earlier for the next workshop."
    }
  ],
