      "fr": "Nadia prépare le plan; elle le relit avec le tuteur.",
      "en": "Nadia prepares the outline; she rereads it with the supervisor."
    },
    {
      "fr": "Sam termine le compte rendu. Il est dans le dossier de projet.",
      "en": "Sam finishes the report. It is in the project file."
    },
    {
      "fr": "La liste de corrections est prête; Nadia la joint au dossier.",
      "en": "The list of corrections is ready; Nadia attaches it to the file."
    },
    {
      "fr": "Les documents sont à jour. Sam les classe par date.",
      "en": "The documents are up to date, so Sam files them by date."
    },
    {
      "fr": "Le brouillon est encore à corriger; l'équipe va le relire ce soir.",
      "en": "The draft still needs correction; the team is going to proofread it this evening."
    },
    {
      "fr": "La formatrice reçoit la version finale dans le dossier de projet.",
      "en": "The instructor receives the final version in the project file."
    }
