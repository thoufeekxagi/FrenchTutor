      "fr": "« Bonjour, monsieur. Votre nom, s'il vous plaît ? »",
      "en": "“Hello, sir. Your name, please?”"
    },
    {
      "fr": "« Tremblay. T-R-E-M-B-L-A-Y. »",
      "en": "“Tremblay. T-R-E-M-B-L-A-Y.”"
    },
    {
      "fr": "« Et votre courriel ? »",
      "en": "“And your email?”"
    },
    {
      "fr": "Sam dit : « sam, arobase, exemple, point c-a. »",
      "en": "Sam says: “sam, at, example, dot c-a.”"
    },
    {
      "fr": "« Pardon ? Pouvez-vous répéter, s'il vous plaît ? »",
      "en": "“Sorry? Can you repeat, please?”"
    },
    {
      "fr": "Sam répète lentement.",
      "en": "Sam repeats slowly.",
      "note": "Lentement is built from lent (slow) + -ment, like -ly in English."
    },
    {
      "fr": "La dame écrit. « Merci, monsieur. Bienvenue ! »",
      "en": "The lady writes. “Thank you, sir. Welcome!”",
      "note": "Here bienvenue means welcome: she welcomes him to the library."
    }
