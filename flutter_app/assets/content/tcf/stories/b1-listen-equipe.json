{
  "id": "b1-listen-equipe",
  "title": "La réunion en deux temps",
  "titleEn": "A meeting in two parts",
  "level": "B1",
  "mode": "listening",
  "minutes": 5,
  "summary": "A team meeting excludes remote colleagues because of poor audio; the group changes the format and records clear follow-up actions.",
  "unit": "b1-u12",
  "sentences": [
    {
      "fr": "L'équipe avait prévu de décider du nouvel horaire pendant une réunion hybride.",
      "en": "The team planned to decide on the new schedule during a hybrid meeting."
    },
    {
      "fr": "Dès le premier sujet, les personnes à distance ont signalé qu'elles entendaient mal.",
      "en": "As soon as the first topic began, remote participants said they could not hear well."
    },
    {
      "fr": "La responsable aurait pu continuer, mais elle a constaté que seules les personnes dans la salle répondaient.",
      "en": "The manager could have continued, but she noticed that only people in the room were responding."
    },
    {
      "fr": "Elle a proposé de suspendre la décision et de reprendre après une pause technique.",
      "en": "She proposed suspending the decision and resuming after a technical break."
    },
    {
      "fr": "Entre-temps, un collègue a testé un micro central et envoyé les documents à tout le monde.",
      "en": "Meanwhile, a colleague tested a central microphone and sent the documents to everyone."
    },
    {
      "fr": "À la reprise, chacun a pu commenter les deux horaires possibles.",
      "en": "When the meeting resumed, everyone could comment on the two possible schedules."
    },
    {
      "fr": "Le groupe a choisi une période d'essai de quatre semaines, avec une date de révision.",
      "en": "The group chose a four-week trial period, with a review date."
    },
    {
      "fr": "La responsable a inscrit les raisons et les objections dans le compte rendu.",
      "en": "The manager wrote the reasons and objections in the minutes."
    },
    {
      "fr": "Cette trace permettra de réviser la décision à partir de l'expérience, plutôt que de l'impression du jour.",
      "en": "This record will allow them to review the decision based on experience rather than that day's impression."
    }
  ],
