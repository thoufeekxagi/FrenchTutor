    {
      "type": "explain",
      "id": "e1",
      "title": "At the café",
      "body": "Léa pays for a coffee. The clerk and Léa use vous.",
      "examples": [
        {
          "fr": "Bonjour. Je vous écoute.",
          "en": "Employé: Hello. I am listening (what would you like?)."
        },
        {
          "fr": "Un café et un croissant, s'il vous plaît.",
          "en": "Léa: A coffee and a croissant, please."
        },
        {
          "fr": "Voilà. Ça fait six dollars.",
          "en": "Employé: Here you are. That is 6 dollars."
        },
        {
          "fr": "C'est combien avec les taxes ?",
          "en": "Léa: How much is it with taxes?"
        },
        {
          "fr": "Avec les taxes, ça fait six dollars quatre-vingt-dix.",
          "en": "Employé: With taxes, it is 6.90."
        },
        {
          "fr": "Je paie par carte.",
          "en": "Léa: I pay by card."
        },
        {
          "fr": "D'accord. Le reçu ?",
          "en": "Employé: Okay. The receipt?"
        },
        {
          "fr": "Oui, s'il vous plaît. Merci !",
          "en": "Léa: Yes, please. Thank you!"
        }
      ]
    },
    {
      "type": "explain",
      "id": "e2",
      "title": "Rent and a bill",
      "body": "Sam and his landlord. They use vous.",
      "examples": [
        {
          "fr": "Bonjour, monsieur. Le loyer est de combien ?",
          "en": "Sam: Hello, sir. How much is the rent?"
        },
        {
          "fr": "Le loyer est de mille deux cents dollars par mois.",
          "en": "Le propriétaire: The rent is 1,200 dollars per month."
        },
        {
          "fr": "Et l'électricité ?",
          "en": "Sam: And the electricity?"
        },
        {
          "fr": "L'électricité coûte quatre-vingts dollars par mois.",
          "en": "Le propriétaire: Electricity costs 80 dollars per month."
        },
        {
          "fr": "Je paie le loyer comment ?",
          "en": "Sam: How do I pay the rent?"
        },
        {
          "fr": "Par virement, le premier du mois.",
          "en": "Le propriétaire: By transfer, on the first of the month."
        }
      ]
