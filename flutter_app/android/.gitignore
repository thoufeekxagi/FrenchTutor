# shared-debug.keystore is NOT tracked (the repo is public). Copy it privately
# to flutter_app/android/app/ on each dev machine so debug builds keep the
# Google-Sign-In-registered SHA-1. Without it, Gradle falls back to the
# machine's own ~/.android/debug.keystore.
app/shared-debug.keystore
